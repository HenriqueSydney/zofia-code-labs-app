generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Habilita suporte a schemas do Postgres e Joins otimizados
  // previewFeatures = ["relationJoins", "fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "catalog", "crm", "projects", "financial", "integrations", "audit"]
}

// =========================================================================
// 1. SCHEMA: IDENTITY (Autenticação, Usuários e Organizações/Tenants)
// =========================================================================

enum Role {
  OWNER
  USER

  @@schema("identity")
}

enum IndustryType {
  SOFTWARE_HOUSE // Seu foco atual
  MARKETING_AGENCY
  ARCHITECTURE_FIRM
  LEGAL
  CONSULTING_GENERAL

  @@schema("identity")
}

/// A "Empresa" ou "Tenant" que utiliza o sistema.
/// Permite que o software seja SaaS (Multi-tenancy).
model Organization {
  id      String  @id @default(cuid())
  name    String  @db.VarChar(255)
  slug    String  @unique @db.VarChar(50) /// Ex: 'zofia-labs' (usado em URLs)
  cnpj    String? @db.VarChar(20)
  logoUrl String?

  industry IndustryType @default(SOFTWARE_HOUSE)
  settings Json?        @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos de isolamento de dados
  users                      User[]
  clients                    Client[]
  projects                   Project[]
  serviceTypes               ServiceType[]
  templates                  DocumentTemplate[]
  invoices                   Invoice[]
  availableIntegrations      OrganizationIntegration[]
  serviceCategories          ServiceCategory[]
  backlogItems               BacklogItem[]
  clientEmployees            ClientEmployees[]
  expenseCategories          ExpenseCategory[]
  expenses                   Expense[]
  budgetEntries              BudgetEntry[]
  serviceDefaultBacklogItems ServiceDefaultBacklogItem[]
  customRoles                CustomRole[]
  members                    Member[]

  @@map("organizations")
  @@schema("identity")
}

/// Usuários do sistema. Podem pertencer a uma organização.
model User {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  name          String?   @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  image         String?   @db.Text
  role          Role      @default(USER)

  // Relacionamentos NextAuth
  accounts Account[]
  sessions Session[]

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects  Project[]
  loginHistories   LoginHistory[]
  projectNotes     ProjectNote[]
  auditLogs        AuditLog[]
  createdProposals Proposal[]     @relation("create_user")

  approvedProposals Proposal[]        @relation("approve_user")
  reviwedProposals  Proposal[]        @relation("review_user")
  createdcontracts  Contract[]        @relation("create_user")
  approvedcontracts Contract[]        @relation("approve_user")
  reviwedcontracts  Contract[]        @relation("review_user")
  backlogItems      BacklogItem[]
  clientEmployees   ClientEmployees[]
  projectMembers    ProjectMember[]
  members           Member[]

  @@map("users")
  @@schema("identity")
}

enum MemberRole {
  TENANT_ADMIN
  TENANT_MEMBER
  TENANT_OBSERVER

  @@schema("identity")
}

model Member {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  // AS PERMISSÕES MUDAM PARA CÁ
  role MemberRole @default(TENANT_MEMBER)

  // Se usar roles customizadas, o vínculo é aqui também
  customRoleId String?     @map("custom_role_id")
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])

  // Permissões específicas só para ESTA organização
  specificPermissions String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  removedAt DateTime?

  // Relacionamentos contextuais (O usuário criou algo COMO membro desta org)
  createdProjects Project[] @relation("created_by_member")

  @@unique([userId, organizationId]) // Um user só pode ser membro 1 vez da mesma org
  @@map("members")
  @@schema("identity")
}

model CustomRole {
  id             String  @id @default(cuid())
  name           String // Ex: "Gerente de Projetos (Empresa A)"
  description    String?
  organizationId String

  // As permissões JSON ou Array de Strings deste perfil
  permissions String[] // ["project:read", "project:create"]

  organization Organization @relation(fields: [organizationId], references: [id])
  members      Member[]

  @@unique([name, organizationId]) // Nomes únicos dentro da mesma empresa
  @@map("custom_role")
  @@schema("identity")
}

/// Contas vinculadas (OAuth)
model Account {
  userId            String
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @map("provider_account_id") @db.VarChar(100)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(50)
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
  @@schema("identity")
}

model LoginHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String? // Ex: "Mozilla/5.0 (Macintosh...)"
  device    String? // Opcional: Se você processar o userAgent depois (ex: "iPhone 13")
  city      String? // Opcional: Se usar geolocalização por IP

  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("identity")
}

model Session {
  sessionToken String   @unique @db.VarChar(255)
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
  @@schema("identity")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @db.VarChar(255)
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
  @@schema("identity")
}

// =========================================================================
// 2. SCHEMA: CATALOG (Configurações e Serviços da Organização)
// =========================================================================

model ServiceCategory {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(100) // Ex: Desenvolvimento de Software
  description String? @db.Text

  taxCode String? @map("tax_code") @db.VarChar(20)

  deletedAt DateTime?

  serviceTypes ServiceType[]

  @@map("service_categories")
  @@schema("catalog")
}

model ServiceType {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Vinculação com a Categoria
  categoryId String          @map("category_id")
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  name        String   @db.VarChar(150)
  description String?  @db.Text
  basePrice   Decimal? @map("base_price") @db.Decimal(15, 2)
  active      Boolean  @default(true)

  proposals                  ProposalItem[]
  projectServices            ProjectServices[]
  serviceDefaultBacklogItems ServiceDefaultBacklogItem[]

  @@map("service_types")
  @@schema("catalog")
}

model ServiceDefaultBacklogItem {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])

  title       String @db.VarChar(255)
  description String
  order       Float  @default(0)

  points   Int             @default(0)
  priority BacklogPriority @default(LOW) // LOW, MEDIUM, HIGH, URGENT

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?
  backlogItems BacklogItem[]

  @@map("service_default_backlog_item")
  @@schema("catalog")
}

enum TemplateType {
  CONTRACT
  PROPOSAL
  DELIVERY_TERM
  OTHER

  @@schema("catalog")
}

/// Modelos de documentos HTML/Markdown
model DocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title             String             @db.VarChar(150)
  content           Json               @db.JsonB
  type              TemplateType
  isSystem          Boolean?           @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  proposalTemplates ProposalTemplate[]
  contractTemplates ContractTemplate[]

  @@map("document_templates")
  @@schema("catalog")
}

// =========================================================================
// 3. SCHEMA: CRM (Comercial)
// =========================================================================

/// Carteira de Clientes da Organização
model Client {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyName String  @map("company_name") @db.VarChar(200)
  tradeName   String  @map("trade_name") @db.VarChar(200)
  slug        String  @unique @db.VarChar(200)
  cnpj        String  @db.VarChar(18)
  email       String  @db.VarChar(255)
  phone       String  @db.VarChar(20)
  address     String? @db.Text

  logoReference String?

  projects Project[]
  invoices Invoice[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  clientEmployees ClientEmployees[]

  // Um cliente deve ser único POR organização (duas empresas diferentes podem ter o mesmo cliente)
  @@unique([organizationId, cnpj])
  @@map("clients")
  @@schema("crm")
}

enum ClientEmployeeRole {
  ADMIN
  USER
  VIEWER

  @@schema("crm")
}

enum ClientEmployeeStatus {
  ACTIVE
  INACTIVE
  PENDING

  @@schema("crm")
}

model ClientEmployees {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  client   Client @relation(fields: [clientId], references: [id])
  clientId String @map("client_id")

  permissionRole ClientEmployeeRole @map("permission_role")

  jobTitle String @map("job_title") @db.VarChar(100)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status ClientEmployeeStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clientId, userId])
  @@map("client_employees")
  @@schema("crm")
}

enum ProposalStatus {
  DRAFT
  REVIEW
  SENT
  APPROVED
  ACCEPTED
  REJECTED
  CANCELLED

  @@schema("crm")
}

enum ProposalSource {
  SYSTEM_TEMPLATE
  MANUAL_UPLOAD

  @@schema("crm")
}

model Proposal {
  id        String  @id @default(cuid())
  version   Int     @default(1)
  isCurrent Boolean @default(true) @map("is_current")
  isActive  Boolean @default(true) @map("is_active")

  status     ProposalStatus @default(DRAFT)
  totalValue Decimal        @map("total_value") @db.Decimal(15, 2)
  validUntil DateTime?      @map("valid_until")

  createdBy   String         @map("created_by")
  createdUser User           @relation(name: "create_user", fields: [createdBy], references: [id])
  sourceType  ProposalSource @default(SYSTEM_TEMPLATE) @map("source_type")

  downPaymentPercentage Int @default(30) @db.SmallInt

  fileKey String? @map("file_key")
  fileUrl String? @map("file_url") // Opcional: Cache da URL pública se for bucket público

  items            ProposalItem[]
  proposalTemplate ProposalTemplate?

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  reviewedAt DateTime?
  reviewedBy String?   @map("reviewed_by")
  reviewUser User?     @relation(name: "review_user", fields: [reviewedBy], references: [id])

  approvedAt   DateTime?
  approvedBy   String?   @map("approved_by")
  approvedUser User?     @relation(name: "approve_user", fields: [approvedBy], references: [id])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contracts Contract[]

  @@unique([projectId, version])
  @@map("proposals")
  @@schema("crm")
}

model ProposalTemplate {
  id String @id @default(cuid())

  template           DocumentTemplate @relation(fields: [documentTemplateId], references: [id])
  documentTemplateId String

  content Json @db.JsonB

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposalId String   @unique @map("proposal_id")
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_templates")
  @@schema("crm")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@schema("crm")
}

model ProposalItem {
  id         String   @id @default(cuid())
  proposalId String   @map("proposal_id")
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  serviceTypeId String      @map("service_type_id")
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])

  price        Decimal      @db.Decimal(15, 2)
  discount     Decimal      @default(0) @db.Decimal(15, 2)
  discountType DiscountType @default(FIXED) @map("discount_type")
  finalPrice   Decimal      @db.Decimal(15, 2)

  @@map("proposal_items")
  @@schema("crm")
}

enum ContractStatus {
  DRAFT
  REVIEW
  SENT
  SIGNED
  REJECTED
  CANCELLED

  @@schema("crm")
}

enum ContractSource {
  SYSTEM_TEMPLATE
  MANUAL_UPLOAD

  @@schema("crm")
}

model Contract {
  id        String  @id @default(cuid())
  version   Int     @default(1)
  isCurrent Boolean @default(true) @map("is_current")
  isActive  Boolean @default(true) @map("is_active")

  proposal   Proposal @relation(fields: [proposalId], references: [id])
  proposalId String

  status ContractStatus @default(DRAFT)

  createdBy   String         @map("created_by")
  createdUser User           @relation(name: "create_user", fields: [createdBy], references: [id])
  sourceType  ContractSource @default(SYSTEM_TEMPLATE) @map("source_type")

  fileKey        String? @map("file_key")
  fileUrl        String? @map("file_url") // Opcional: Cache da URL pública se for bucket público
  externalSignId String? @map("external_sign_id")

  contractTemplate ContractTemplate?

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  reviewedAt DateTime?
  reviewedBy String?   @map("reviewed_by")
  reviewUser User?     @relation(name: "review_user", fields: [reviewedBy], references: [id])

  approvedAt   DateTime?
  approvedBy   String?   @map("approved_by")
  approvedUser User?     @relation(name: "approve_user", fields: [approvedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@map("contracts")
  @@schema("crm")
}

model ContractTemplate {
  id String @id @default(cuid())

  template           DocumentTemplate @relation(fields: [documentTemplateId], references: [id])
  documentTemplateId String

  content Json @db.JsonB

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractId String   @unique @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_templates")
  @@schema("crm")
}

// =========================================================================
// 4. SCHEMA: PROJECTS (Core do Sistema)
// =========================================================================

enum ProjectStatus {
  DRAFT
  TECH_ANALYSIS
  PROPOSAL
  PROPOSAL_GENERATED
  WAITING_SIGNATURE
  WAITING_DOWN_PAYMENT
  PLANNED
  IN_PROGRESS
  REVIEW
  ON_HOLD
  DELIVERED
  FINAL_PAYMENT
  COMPLETED
  CANCELLED
  MAINTENANCE

  @@schema("projects")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@schema("projects")
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK

  @@schema("projects")
}

model Project {
  id String @id @default(cuid())

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(200)
  description String? @db.Text

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  status ProjectStatus

  priority Priority      @default(MEDIUM)
  health   ProjectHealth @default(ON_TRACK)

  tags String[]

  estimatedStartDate DateTime? @map("estimated_start_date")
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")

  totalBudget     Decimal @default(0) @db.Decimal(15, 2)
  totalSpent      Decimal @default(0) @db.Decimal(15, 2)
  remainingBudget Decimal @default(0) @db.Decimal(15, 2)

  invoices Invoice[]

  notes   ProjectNote[]
  sprints Sprint[]
  backlog BacklogItem[]

  createdBy String @map("created_by")
  user      User   @relation(fields: [createdBy], references: [id])

  proposal Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrations         ProjectIntegration[]
  projectServices      ProjectServices[]
  projectDocuments     ProjectDocuments[]
  contracts            Contract[]
  budgetEntries        BudgetEntry[]
  expenses             Expense[]
  sonarMetricSnapshots SonarMetricSnapshot[]
  umamiMetricSnapshots UmamiMetricSnapshot[]
  projectMembers       ProjectMember[]
  member               Member?               @relation(name: "created_by_member", fields: [memberId], references: [id])
  memberId             String?

  @@map("projects")
  @@schema("projects")
}

model ProjectRoles {
  id String @id @default(cuid())

  role           String          @db.VarChar(50)
  description    String          @db.VarChar(500)
  projectMembers ProjectMember[]

  @@map("project_roles")
  @@schema("projects")
}

model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Cargo naquele período específico
  projectRolesId String
  projectRole    ProjectRoles @relation(fields: [projectRolesId], references: [id])

  allocation Float @default(100)

  // O segredo está aqui: Janela de Tempo
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at") // Se null, está ativo atualmente

  // Adicione índices para busca rápida
  @@index([projectId, userId])
  @@index([userId])
  @@map("project_members")
  @@schema("projects")
}

model ProjectDocuments {
  id String @id @default(cuid())

  project Project @relation(fields: [projectId], references: [id])

  name      String   @default("Attachment")
  extension String   @default("pdf")
  createdAt DateTime @default(now())

  documentUrlReference String @map("document_url_reference")
  projectId            String

  @@map("projects_documents")
  @@schema("projects")
}

model ProjectServices {
  project       Project     @relation(fields: [projectId], references: [id])
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  projectId     String
  serviceTypeId String

  @@id([projectId, serviceTypeId])
  @@map("projects_services")
  @@schema("projects")
}

model ProjectNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("project_notes")
  @@schema("projects")
}

model Sprint {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String   @db.VarChar(100)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  // Status financeiro/gerencial (Zofia manda)
  status String @default("OPEN")

  // Métricas de Execução (Vêm do Taiga)
  totalPoints       Int?     @default(0) @map("total_points")
  completedPoints   Int?     @default(0) @map("completed_points")
  completionPercent Decimal? @default(0) @map("completion_percent") @db.Decimal(5, 2) // 0 a 100.00

  // O Vínculo Mágico
  externalId  String?   @map("external_id") @db.VarChar(100) // ID do Milestone no Taiga
  externalUrl String?   @map("external_url") // Link direto pro board
  lastSyncAt  DateTime? @map("last_sync_at") // Quando foi a última atualização?

  // Configuração Específica da Integração deste Projeto
  // Ex: { "taigaProjectId": 542, "syncEnabled": true, "webhookSecret": "xyz" }
  // Avalie no schema de integrações
  //integrationSettings Json? @map("integration_settings") @db.JsonB

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  backlogItems BacklogItem[]

  @@map("sprints")
  @@schema("projects")
}

enum BacklogPriority {
  URGENT
  HIGH
  MEDIUM
  LOW

  @@schema("projects")
}

enum BacklogStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELED

  @@schema("projects")
}

model BacklogItem {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(255)
  description String
  status      BacklogStatus @default(TODO)
  order       Float         @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  points     Int             @default(0) // Story Points ou Horas
  priority   BacklogPriority @default(LOW) // LOW, MEDIUM, HIGH, URGENT
  assigneeId String?         @map("assignee_id") // Quem vai fazer (User)
  assignee   User?           @relation(fields: [assigneeId], references: [id])

  externalLink String? @map("external_link") // Link pro card no Jira/Taiga original

  serviceDefaultBacklogItem   ServiceDefaultBacklogItem? @relation(fields: [serviceDefaultBacklogItemId], references: [id])
  serviceDefaultBacklogItemId String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime?

  @@map("backlog_items")
  @@schema("projects")
}

// =========================================================================
// 5. SCHEMA: FINANCIAL (Financeiro & Jobs AWS)
// =========================================================================

enum BudgetEntryType {
  INITIAL // Aporte inicial do projeto
  ADJUSTMENT // Ajuste positivo (aumento de verba)
  REDUCTION // Redução/Bloqueio (valor negativo)
  REFUND // Estorno de despesa

  @@schema("financial")
}

model BudgetEntry {
  id String @id @default(cuid())

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  type        BudgetEntryType @default(INITIAL)
  description String?

  amount Decimal @db.Decimal(15, 2)

  consumedAmount   Decimal @default(0) @db.Decimal(15, 2)
  remainingBalance Decimal @default(0) @db.Decimal(15, 2)

  createdBy String? // ID do usuário que realizou a operação
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_budget_entries")
  @@schema("financial")
}

enum ExpenseNature {
  OPERATIONAL // Gastos recorrentes da empresa
  DIRECT_PROJECT // Gastos diretos de um projeto
  INVESTMENT // Compra de ativos (Laptops, etc)
  PERSONAL // Gastos dos sócios/pessoais

  @@schema("financial")
}

model ExpenseCategory {
  id String @id @default(cuid())

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(100)
  description String? @db.Text

  nature ExpenseNature @default(OPERATIONAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expenses Expense[]

  @@map("expense_category")
  @@schema("financial")
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  // Melhoria: Separar fornecedor da descrição
  description String // Ex: "Renovação Anual"
  supplier    String? // Ex: "JetBrains", "AWS"

  amount Decimal @db.Decimal(15, 2)

  expenseCategoryId String
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])

  // Melhoria: Controle de Status e Datas
  status  ExpenseStatus @default(PENDING) // Enum: PENDING, PAID, CANCELED
  date    DateTime      @default(now())
  dueDate DateTime?     @map("due_date") // Data de vencimento
  paidAt  DateTime?     @map("paid_at") // Data do efetivo pagamento

  // Melhoria: Link para comprovante (S3/R2)
  attachmentUrl String? @map("attachment_url")

  // Melhoria: Quem criou
  createdById String? @map("created_by_id")
  // createdBy   User?   @relation(...) // Se tiver model de User

  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([organizationId])
  @@index([status]) // Importante para filtros
  @@map("project_expenses")
  @@schema("financial")
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELED
  SCHEDULED

  @@schema("financial")
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED

  @@schema("financial")
}

enum InternetBankingProvider {
  CORA
  PAYPAL
  MERCADO_PAGO
  STRIPE

  @@schema("financial")
}

enum PaymentType {
  PIX
  BOLETO
  CREDIT_CARD
  DEBIT_CARD

  @@schema("financial")
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  internetBankingProvider InternetBankingProvider

  paymentType PaymentType

  amount  Decimal         @db.Decimal(15, 2)
  dueDate DateTime        @map("due_date")
  paidAt  DateTime?       @map("paid_at")
  status  FinancialStatus @default(PENDING)

  description String  @db.VarChar(255)
  nfseNumber  String? @map("nfse_number") @db.VarChar(50)
  nfseLink    String? @map("nfse_link") @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
  @@schema("financial")
}

enum JobType {
  EMIT_NFSE
  GENERATE_CONTRACT_PDF
  SEND_EMAIL_REMINDER

  @@schema("financial")
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@schema("financial")
}

// =========================================================================
// 6. SCHEMA: INTEGRATIONS (Configurações de Integrações)
// =========================================================================

/// Nível 1: Catálogo Global (O que o seu software suporta)
/// Ex: { name: "GitHub", slug: "github", logo: "..." }
model IntegrationType {
  id         String  @id @default(cuid())
  name       String  @db.VarChar(100)
  slug       String  @unique @db.VarChar(50) /// Identificador único no código
  logo       String? @db.Text
  enableByol Boolean @default(false) @map("enable_byol") /// Habilitar possibilidade de Trazer a própria licença

  description String? @db.Text

  externalDocsUrl String? @db.Text

  fieldsSchema Json? @db.JsonB

  // Relações
  organizationConfig OrganizationIntegration[]
  projectConfig      ProjectIntegration[]

  deletedAt DateTime?

  @@map("integration_types")
  @@schema("integrations")
}

enum IntegrationStatus {
  HEALTHY
  WARNNING
  ERROR

  @@schema("integrations")
}

/// Nível 2: Disponibilidade da Organização (O que o cliente ativou)
/// Aqui ficam credenciais GLOBAIS da empresa (ex: Token do Slack da Empresa)
model OrganizationIntegration {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  integrationTypeId String             @map("integration_type_id")
  integrationType   IntegrationType    @relation(fields: [integrationTypeId], references: [id])
  enableByol        Boolean            @default(false) @map("enable_byol") /// Habilitar possibilidade de Trazer a própria licença
  lastHealthCheck   DateTime?
  healthStatus      IntegrationStatus? // "healthy", "warning", "error"
  lastError         String?
  errorCount        Int                @default(0)

  enabled Boolean @default(true)

  /// Configurações gerais da organização (API Keys, Client Secrets)
  /// CUIDADO: Campos sensíveis devem ser encriptados antes de salvar aqui
  config Json? @db.JsonB

  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  projectIntegrations ProjectIntegration[]

  // Garante que a organização só tenha 1 configuração para cada tipo de integração
  @@unique([organizationId, integrationTypeId])
  @@map("organization_integrations")
  @@schema("integrations")
}

/// Nível 3: Uso no Projeto (A instância real)
/// Ex: Projeto X usa GitHub (IntegrationType) com o Repo URL Y (Config)
model ProjectIntegration {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  integrationTypeId String          @map("integration_type_id")
  integrationType   IntegrationType @relation(fields: [integrationTypeId], references: [id])

  organizationIntegrationId String                  @map("organization_integration_id")
  organizationIntegration   OrganizationIntegration @relation(fields: [organizationIntegrationId], references: [id])

  /// Configuração específica deste projeto
  /// Ex: { "repoUrl": "...", "channelId": "...", "webhookUrl": "..." }
  config Json? @db.JsonB

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_integrations")
  @@schema("integrations")
}

model SonarMetricSnapshot {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Controle de tempo para os gráficos de evolução
  timestamp DateTime @default(now())

  bugs            Int
  vulnerabilities Int
  codeSmells      Int
  coverage        Float
  duplications    Float
  technicalDebt   Int // Armazenado em minutos (sqale_index)
  status          String // OK, ERROR, WARN (alert_status)
  securityRating  String // A, B, C, D, E

  blockerViolations  Int @default(0)
  criticalViolations Int @default(0)
  majorViolations    Int @default(0)
  minorViolations    Int @default(0)
  infoViolations     Int @default(0)

  gateConditions SonarQualityGateCondition[]

  @@index([projectId, timestamp(sort: Desc)])
  @@index([status])
  @@map("sonar_metric_snapshots")
  @@schema("integrations")
}

model SonarQualityGateCondition {
  id         String              @id @default(uuid())
  snapshotId String
  snapshot   SonarMetricSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  metric    String // ex: "new_coverage", "critical_violations"
  value     String // Valor atual (string pois pode ser "80.5" ou "true")
  threshold String // Limite definido no Sonar
  status    String // OK, ERROR, WARN

  @@index([snapshotId])
  @@map("sonar_quality_gate_conditions")
  @@schema("integrations")
}

model UmamiMetricSnapshot {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Controle de tempo para evolução temporal (Time-series)
  timestamp DateTime @default(now())

  // Métricas Principais (Stats)
  pageviews   Int   @default(0)
  visitors    Int   @default(0) // Visitantes únicos
  visits      Int   @default(0) // Sessões
  bounceRate  Float @default(0) // Em porcentagem
  totalTime   Int   @default(0) // Tempo total em segundos para cálculo de média
  avgDuration Int   @default(0) // Duração média em segundos

  // Métricas de Engajamento Extra
  pagesPerSession Float @default(0)

  // Armazenamento opcional de dados dimensionais em JSON 
  // (Evita criar muitas tabelas para Browser, OS, Dispositivo, etc)
  breakdown Json? @db.JsonB
  /**
   * Ex breakdown: {
   * "browsers": [{ "name": "Chrome", "value": 100 }],
   * "devices": [{ "name": "mobile", "value": 50 }]
   * }
   */

  @@index([projectId, timestamp(sort: Desc)])
  @@map("umami_metric_snapshots")
  @@schema("integrations")
}

model WebhookLog {
  id        String   @id @default(cuid())
  provider  String // "DOCUMENSO"
  eventId   String   @unique // ID do evento que vem no header/body
  payload   Json
  status    String // "PROCESSED", "FAILED"
  error     String?
  createdAt DateTime @default(now())

  @@map("webhook_logs")
  @@schema("integrations")
}

// =========================================================================
// 7. SCHEMA: AUDIT (Auditorias)
// =========================================================================

model AuditLog {
  idString String @id @default(cuid())

  entityType String
  entityId   String

  action String

  changes Json?

  metadata Json?

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  timestamp DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
  @@schema("audit")
}

